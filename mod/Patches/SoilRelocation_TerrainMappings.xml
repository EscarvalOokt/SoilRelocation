            <xpath>Defs/TerrainDef[defName="Sand"]/modExtensions</xpath>
            <match Class="PatchOperationAdd">
                <xpath>Defs/TerrainDef[defName="Sand"]/modExtensions</xpath>
                <value>
                    <li Class="SoilRelocation.Domain.RelocationTerrainExtension">
                        <Family>SoilRelocation_SandFamily</Family>
                    </li>
                </value>
            </match>
            <nomatch Class="PatchOperationAdd">
