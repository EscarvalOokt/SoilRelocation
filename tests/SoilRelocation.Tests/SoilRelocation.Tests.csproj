<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>SoilRelocation.Tests</RootNamespace>
        <AssemblyName>SoilRelocation.Tests</AssemblyName>
        <IsTestProject>true</IsTestProject>
        <IsPackable>false</IsPackable>
        <Nullable>disable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk"
                          Version="18.8.1"/>

        <PackageReference Include="NUnit"
                          Version="4.6.1"/>

        <PackageReference Include="NUnit3TestAdapter"
                          Version="6.2.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\SoilRelocation\SoilRelocation.csproj"/>
    </ItemGroup>

    <Import Project="..\..\src\SoilRelocation.Local.props"
            Condition="Exists('..\..\src\SoilRelocation.Local.props')"/>

    <ItemGroup Condition="'$(RimWorldManagedDir)' != ''">
        <Reference Include="Assembly-CSharp">
            <HintPath>$(RimWorldManagedDir)\Assembly-CSharp.dll</HintPath>
            <Private>true</Private>
        </Reference>

        <Reference Include="UnityStubs">
            <HintPath>$(RimWorldManagedDir)\UnityStubs.dll</HintPath>
            <Private>true</Private>
        </Reference>
    </ItemGroup>
</Project>