<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>SoilRelocation.Removal.RuntimeTests</RootNamespace>
        <AssemblyName>SoilRelocation.Removal.RuntimeTests</AssemblyName>
        <Nullable>disable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <RemovalTestModAssembliesDir>$(MSBuildProjectDirectory)\..\SoilRelocation.Removal.TestMod\Assemblies</RemovalTestModAssembliesDir>
    </PropertyGroup>

    <Import Project="..\..\src\SoilRelocation.Local.props"
            Condition="Exists('..\..\src\SoilRelocation.Local.props')"/>

    <ItemGroup Condition="'$(RimWorldManagedDir)' != ''">
        <Reference Include="Assembly-CSharp">
            <HintPath>$(RimWorldManagedDir)\Assembly-CSharp.dll</HintPath>
            <Private>false</Private>
        </Reference>

        <Reference Include="UnityStubs">
            <HintPath>$(RimWorldManagedDir)\UnityStubs.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <Target Name="CopyAssemblyToRemovalTestMod"
            AfterTargets="Build">
        <MakeDir Directories="$(RemovalTestModAssembliesDir)"/>

        <Copy SourceFiles="$(TargetPath)"
              DestinationFolder="$(RemovalTestModAssembliesDir)"
              SkipUnchangedFiles="true"/>
    </Target>
</Project>