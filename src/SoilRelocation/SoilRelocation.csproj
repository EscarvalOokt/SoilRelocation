<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>SoilRelocation</RootNamespace>
        <AssemblyName>SoilRelocation</AssemblyName>
        <Nullable>disable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <CurrentRimWorldVersion>1.7</CurrentRimWorldVersion>
        <Version>1.1.0</Version>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="SoilRelocation.Tests"/>
        <InternalsVisibleTo Include="SoilRelocation.Extensibility.RuntimeTests"/>
        <InternalsVisibleTo Include="SoilRelocation.Placement.RuntimeTests"/>
    </ItemGroup>

    <Import Project="..\SoilRelocation.Local.props"
            Condition="Exists('..\SoilRelocation.Local.props')"/>

    <PropertyGroup>
        <DeployToGame Condition="'$(DeployToGame)' == ''">false</DeployToGame>
    </PropertyGroup>

    <Target Name="ValidateLocalConfiguration"
            BeforeTargets="ResolveReferences">
        <Error Condition="'$(RimWorldManagedDir)' == ''"
               Text="Set RimWorldManagedDir in src\SoilRelocation.Local.props to the RimWorld 1.7 installation root using docs\SoilRelocation.Local.props.example."/>

        <Error Condition="'$(RimWorldManagedDir)' != '' and !Exists('$(RimWorldManagedDir)\Assembly-CSharp.dll')"
               Text="Assembly-CSharp.dll was not found in '$(RimWorldManagedDir)'. Update RimWorldManagedDir in src\SoilRelocation.Local.props."/>

        <Error Condition="'$(RimWorldManagedDir)' != '' and !Exists('$(RimWorldManagedDir)\UnityStubs.dll')"
               Text="UnityStubs.dll was not found in '$(RimWorldManagedDir)'. Use the RimWorld 1.7 installation root."/>

        <Error Condition="'$(HarmonyDllPath)' == '' or !Exists('$(HarmonyDllPath)')"
               Text="Set HarmonyDllPath in src\SoilRelocation.Local.props to the 0Harmony.dll loaded by Harmony for RimWorld 1.7."/>

        <Error Condition="'$(DeployToGame)' != 'true' and '$(DeployToGame)' != 'false'"
               Text="DeployToGame must be true or false."/>
    </Target>

    <ItemGroup Condition="'$(RimWorldManagedDir)' != ''">
        <Reference Include="Assembly-CSharp">
            <HintPath>$(RimWorldManagedDir)\Assembly-CSharp.dll</HintPath>
            <Private>false</Private>
        </Reference>

        <Reference Include="UnityStubs">
            <HintPath>$(RimWorldManagedDir)\UnityStubs.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <Reference Include="0Harmony">
            <HintPath>$(HarmonyDllPath)</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <Import Project="..\..\build\ModDeployment.targets"/>
</Project>