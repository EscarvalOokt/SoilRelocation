<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net472</TargetFramework>
        <RootNamespace>SoilRelocation</RootNamespace>
        <AssemblyName>SoilRelocation</AssemblyName>
        <Nullable>disable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="SoilRelocation.Tests"/>
        <InternalsVisibleTo Include="SoilRelocation.Extensibility.RuntimeTests"/>
        <InternalsVisibleTo Include="SoilRelocation.Placement.RuntimeTests"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Lib.Harmony.Ref"
                          Version="2.4.2"
                          PrivateAssets="all"/>
    </ItemGroup>

    <Import Project="..\SoilRelocation.Local.props"
            Condition="Exists('..\SoilRelocation.Local.props')"/>

    <Target Name="ValidateLocalConfiguration"
            BeforeTargets="ResolveReferences">
        <Error Condition="'$(RimWorldManagedDir)' == ''"
               Text="RimWorldManagedDir is not configured. Create src\SoilRelocation.Local.props from docs\SoilRelocation.Local.props.example and set the path to RimWorld's Managed directory."/>

        <Error Condition="'$(RimWorldManagedDir)' != '' and !Exists('$(RimWorldManagedDir)\Assembly-CSharp.dll')"
               Text="Assembly-CSharp.dll was not found in '$(RimWorldManagedDir)'. Update RimWorldManagedDir in src\SoilRelocation.Local.props."/>

        <Error Condition="'$(RimWorldModAssembliesDir)' == ''"
               Text="RimWorldModAssembliesDir is not configured. Update src\SoilRelocation.Local.props."/>
    </Target>

    <ItemGroup Condition="'$(RimWorldManagedDir)' != ''">
        <Reference Include="Assembly-CSharp">
            <HintPath>$(RimWorldManagedDir)\Assembly-CSharp.dll</HintPath>
            <Private>false</Private>
        </Reference>

        <Reference Include="UnityEngine"
                   Condition="Exists('$(RimWorldManagedDir)\UnityEngine.dll')">
            <HintPath>$(RimWorldManagedDir)\UnityEngine.dll</HintPath>
            <Private>false</Private>
        </Reference>

        <Reference Include="UnityEngine.CoreModule"
                   Condition="Exists('$(RimWorldManagedDir)\UnityEngine.CoreModule.dll')">
            <HintPath>$(RimWorldManagedDir)\UnityEngine.CoreModule.dll</HintPath>
            <Private>false</Private>
        </Reference>

        <Reference Include="UnityEngine.TextRenderingModule"
                   Condition="Exists('$(RimWorldManagedDir)\UnityEngine.TextRenderingModule.dll')">
            <HintPath>$(RimWorldManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath>
            <Private>false</Private>
        </Reference>

        <Reference Include="UnityEngine.IMGUIModule"
                   Condition="Exists('$(RimWorldManagedDir)\UnityEngine.IMGUIModule.dll')">
            <HintPath>$(RimWorldManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <Target Name="CopyAssemblyToMod"
            AfterTargets="Build"
            Condition="'$(RimWorldModAssembliesDir)' != ''">
        <MakeDir Directories="$(RimWorldModAssembliesDir)"/>

        <Copy SourceFiles="$(TargetPath)"
              DestinationFolder="$(RimWorldModAssembliesDir)"
              SkipUnchangedFiles="true"/>
    </Target>
</Project>